#include <gtk/gtk.h>
#include <cairo.h>
#include <gdk/gdkx.h>
#include <gdk/gdkx11window.h>
#include <X11/Xlib.h>
#include <stdlib.h>

extern void draw_screen(
    cairo_t *cr,
    int width,
    int height
);

static gboolean on_draw(
    GtkWidget *widget,
    cairo_t *cr,
    gpointer data
)
{
    GtkAllocation allocation;

    gtk_widget_get_allocation(
        widget,
        &allocation
    );

    draw_screen(
        cr,
        allocation.width,
        allocation.height
    );

    return TRUE;
}

void screen_init(void)
{
    int argc = 0;
    char **argv = NULL;

    gtk_init(&argc, &argv);
}


